# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL for webhooks and callback links
APP_URL="https://nepalai.tech"

# ADMIN_NOTIFICATION_EMAIL: Private server recipient for enterprise lead alerts
ADMIN_NOTIFICATION_EMAIL="prakash@scamspike.com"

# Optional SMTP configuration for live outbound email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# STUDIO_ADMIN_URL: Direct admin dashboard connection to studio.nepalai.tech
STUDIO_ADMIN_URL="https://studio.nepalai.tech/admin"

# =========================================================================
# CLOUD SQL (POSTGRESQL) & FIREBASE AUTHENTICATION
# =========================================================================
SQL_HOST="/cloudsql/your-project:region:instance"
SQL_DB_NAME="app_db"
SQL_USER="app_user"
SQL_PASSWORD="your-sql-app-password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your-sql-admin-password"

# =========================================================================
# CLOUDFLARE R2 OBJECT STORAGE (S3-COMPATIBLE ZERO EGRESS)
# =========================================================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="nepalai-studio-media"
R2_PUBLIC_URL="https://media.nepalai.tech"

# =========================================================================
# NEPAL PAYMENT GATEWAYS (ESEWA & KHALTI)
# =========================================================================
ESEWA_MERCHANT_CODE="EPAYTEST"
ESEWA_SECRET_KEY=
KHALTI_PUBLIC_KEY="test_public_key_nepalai"
KHALTI_SECRET_KEY="test_secret_key_nepalai"

# =========================================================================
# NEPAL AI + TRENDS (WHATSAPP BUSINESS RELAY & TRENDS ALPHA API)
# =========================================================================
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GOOGLE_TRENDS_API_KEY=
GOOGLE_TRENDS_API_ENDPOINT=
