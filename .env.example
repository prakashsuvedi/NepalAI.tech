# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL for webhooks and callback links
APP_URL="https://nepalai.tech"

# ADMIN_NOTIFICATION_EMAIL: Private server recipient for enterprise lead alerts
ADMIN_NOTIFICATION_EMAIL="prakash@scamspike.com"

# Optional SMTP configuration for live outbound email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# STUDIO_ADMIN_URL: Direct admin dashboard connection to studio.nepalai.tech
STUDIO_ADMIN_URL="https://studio.nepalai.tech/admin"

# =========================================================================
# SUPABASE AUTHENTICATION & DRIZZLE POSTGRESQL DATABASE
# =========================================================================
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres"

# =========================================================================
# CLOUDFLARE R2 OBJECT STORAGE (S3-COMPATIBLE ZERO EGRESS)
# =========================================================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="nepalai-studio-media"
R2_PUBLIC_URL="https://media.nepalai.tech"

# =========================================================================
# NEPAL PAYMENT GATEWAYS (ESEWA & KHALTI)
# =========================================================================
ESEWA_MERCHANT_CODE="EPAYTEST"
ESEWA_SECRET_KEY=
KHALTI_PUBLIC_KEY="test_public_key_nepalai"
KHALTI_SECRET_KEY="test_secret_key_nepalai"

